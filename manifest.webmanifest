{
  "name": "Controle de Treino",
  "short_name": "Treino",
  "description": "Registro rápido de treinos, periodização, progressão de cargas e histórico — funciona offline.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "controle-de-treino",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0c110e",
  "theme_color": "#121a14",
  "categories": [
    "health",
    "fitness",
    "sports",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "data:image/png;base64,",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "data:image/png;base64,",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "data:image/png;base64,",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Registrar treino",
      "short_name": "Registrar",
      "url": "./index.html#session",
      "icons": [
        {
          "src": "data:image/png;base64,",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Histórico",
      "short_name": "Histórico",
      "url": "./index.html#history",
      "icons": [
        {
          "src": "data:image/png;base64,",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}